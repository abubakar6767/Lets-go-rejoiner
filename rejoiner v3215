--[[
    AUTO-JOIN VERSION <= 3215 WITH SERVER HOPPING & DRAGGABLE GUI
    Target PlaceID: 126884695634066
]]

repeat task.wait() until game:IsLoaded()

local TeleportService = game:GetService("TeleportService")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local targetPlaceId = 126884695634066
local maxVersion = 3215
local localPlayer = Players.LocalPlayer

--------------------------------------------------------------------------------
-- 1. SHOP AUTO-BUY LOOP (Background Task)
--------------------------------------------------------------------------------
task.spawn(function()
    local remote = ReplicatedStorage:WaitForChild("GameEvents", 10)
        and ReplicatedStorage.GameEvents:WaitForChild("BuyEventShopStock", 10)

    if not remote then return end

    while true do
        for _, shop in ipairs({ "Blood Moon Shop", "Twilight Shop" }) do
            pcall(function()
                remote:FireServer("Night Egg", shop)
            end)
            task.wait(0.1)
        end
        task.wait(10)
    end
end)

--------------------------------------------------------------------------------
-- 2. CENTERED & DRAGGABLE GUI SETUP
--------------------------------------------------------------------------------
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "VersionTrackerGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = localPlayer:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 320, 0, 90)
frame.AnchorPoint = Vector2.new(0.5, 0.5)
frame.Position = UDim2.new(0.5, 0, 0.5, 0)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = screenGui

local uiCorner = Instance.new("UICorner")
uiCorner.CornerRadius = UDim.new(0, 8)
uiCorner.Parent = frame

local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -20, 1, -20)
statusLabel.Position = UDim2.new(0, 10, 0, 10)
statusLabel.BackgroundTransparency = 1
statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
statusLabel.TextSize = 14
statusLabel.Font = Enum.Font.SourceSansBold
statusLabel.TextWrapped = true
statusLabel.Text = "Checking current server version..."
statusLabel.Parent = frame

-- Draggable UI Implementation
local dragging, dragStart, startPos

frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

--------------------------------------------------------------------------------
-- 3. DIRECT VERSION CHECK & SERVER HOPPER
--------------------------------------------------------------------------------
local function serverHop()
    statusLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
    statusLabel.Text = "Version too high! Hopping servers..."

    local req = (syn and syn.request) or (http and http.request) or http_request or (Fluxus and Fluxus.request) or request
    local serversUrl = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", targetPlaceId)

    local success, response = pcall(function()
        if req then
            return req({ Url = serversUrl, Method = "GET" }).Body
        else
            return game:HttpGet(serversUrl)
        end
    end)

    if success and response then
        local data = HttpService:JSONDecode(response)
        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.id ~= game.JobId and server.playing < server.maxPlayers then
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(targetPlaceId, server.id, localPlayer)
                    end)
                    task.wait(3)
                end
            end
        end
    end

    -- Fallback Teleport
    TeleportService:Teleport(targetPlaceId, localPlayer)
end

-- Read version natively from current engine state
task.spawn(function()
    task.wait(1)
    local currentVersion = game.PlaceVersion

    if currentVersion <= maxVersion then
        statusLabel.TextColor3 = Color3.fromRGB(85, 255, 127)
        statusLabel.Text = string.format("Target Server Match!\nVersion: %d (<= %d)\nStaying in this server.", currentVersion, maxVersion)
    else
        statusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
        statusLabel.Text = string.format("Current Version: %d (> %d)\nInitiating Server Hop...", currentVersion, maxVersion)
        task.wait(2)
        serverHop()
    end
end)
