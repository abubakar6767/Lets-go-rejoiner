local statusLabel = Instance.new("TextLabel")
statusLabel.Size = UDim2.new(1, -20, 1, -20)
statusLabel.Position = UDim2.new(0, 10, 0, 10)
statusLabel.BackgroundTransparency = 1
statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
statusLabel.TextSize = 14
statusLabel.Font = Enum.Font.SourceSansBold
statusLabel.TextWrapped = true
statusLabel.Text = "Checking server version..."
statusLabel.Parent = frame

-- Draggable Logic
local dragging, dragStart, startPos
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = frame.Position
    end
end)

frame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

--------------------------------------------------------------------------------
-- 3. SERVER HOPPER & VERSION CHECK LOGIC
--------------------------------------------------------------------------------
local function serverHop()
    statusLabel.TextColor3 = Color3.fromRGB(255, 170, 0)
    statusLabel.Text = "Version too high! Server hopping..."

    local serversUrl = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", targetPlaceId)
    local success, response = pcall(function()
        return httpRequest({ Url = serversUrl, Method = "GET" }).Body
    end)

    if success and response then
        local data = HttpService:JSONDecode(response)
        if data and data.data then
            for _, server in ipairs(data.data) do
                if server.id ~= game.JobId and server.playing < server.maxPlayers then
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(targetPlaceId, server.id, localPlayer)
                    end)
                    task.wait(3)
                end
            end
        end
    end

    TeleportService:Teleport(targetPlaceId, localPlayer)
end

-- Version Verification Task
task.spawn(function()
    local currentVersion = game.PlaceVersion

    -- If in target game place
    if game.PlaceId == targetPlaceId then
        if currentVersion <= maxVersion then
            statusLabel.TextColor3 = Color3.fromRGB(85, 255, 127)
            statusLabel.Text = string.format("Target Version Match!\nVersion: %d (<= %d)\nStaying in this server.", currentVersion, maxVersion)
        else
            statusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
            statusLabel.Text = string.format("Current Version: %d (> %d)\nInitiating Server Hop...", currentVersion, maxVersion)
            task.wait(2)
            serverHop()
        end
    else
        -- If currently in a different place, check target place version via Web API
        local apiUrl = string.format("https://economy.roblox.com/v2/assets/%d/details", targetPlaceId)
        local success, response = pcall(function()
            return httpRequest({ Url = apiUrl, Method = "GET" }).Body
        end)

        if success and response then
            local data = HttpService:JSONDecode(response)
            local fetchedVersion = data and data.TargetId or 0
            
            -- Teleport to target place to check instance
            TeleportService:Teleport(targetPlaceId, localPlayer)
        else
            statusLabel.TextColor3 = Color3.fromRGB(255, 85, 85)
            statusLabel.Text = "HTTP fetch failed. Hopping..."
            task.wait(2)
            serverHop()
        end
    end
end)
