local function scanForServers()
    clearList()
    statusLabel.TextColor3 = Color3.fromRGB(255, 180, 60)
    statusLabel.Text = "Fetching active server instances..."
    
    local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", TARGET_PLACE_ID)
    local res = makeHttpRequest(url)

    if res and res.Body then
        local success, parsed = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if success and parsed and parsed.data then
            local foundCount = 0
            
            -- Checks current active server version first
            if game.PlaceId == TARGET_PLACE_ID and game.PlaceVersion == TARGET_VERSION then
                createServerCard(game.JobId, #Players:GetPlayers(), Players.MaxPlayers)
                foundCount = foundCount + 1
            end

            -- Parse server instances
            for _, server in ipairs(parsed.data) do
                if server.playing < server.maxPlayers then
                    -- Displays available server instances ready for join verification
                    createServerCard(server.id, server.playing, server.maxPlayers)
                    foundCount = foundCount + 1
                end
            end

            if foundCount > 0 then
                statusLabel.TextColor3 = Color3.fromRGB(85, 255, 140)
                statusLabel.Text = string.format("Found %d available server(s). Select one to join.", foundCount)
            else
                statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
                statusLabel.Text = "No active servers matching target criteria."
            end
        else
            statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
            statusLabel.Text = "Failed to parse public server response."
        end
    else
        statusLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
        statusLabel.Text = "HTTP request failed. Please check executor network permissions."
    end
end

scanBtn.MouseButton1Click:Connect(scanForServers)
